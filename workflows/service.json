        "operation": "executeQuery",
        "query": "INSERT INTO sessions (sender_id, stage, draft, revision)\nVALUES ($1, $2, $3::jsonb, $4)\nON CONFLICT (sender_id) DO UPDATE SET\n  stage = EXCLUDED.stage, draft = EXCLUDED.draft,\n  revision = EXCLUDED.revision, updated_at = now()\nRETURNING stage, $5::text AS resposta;",
        "options": {
          "queryReplacement": "={{ [$json.sender_id, $json.stage, JSON.stringify($json.draft), $json.revision, $json.reply] }}"
