    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const entrada = $('Entrada').item.json;\nconst texto = entrada.text.trim();\nconst etapa = $json.stage;\nconst draft = { ...$json.draft };\n\nlet stage = etapa;\nlet reply = 'Responda com seu nome para continuar.';\n\nif (etapa === 'inicio') {\n  stage = 'nome';\n  reply = 'Oi! Qual nome deve aparecer no currículo?';\n} else if (etapa === 'nome' && texto.length > 0 && texto.length <= 120) {\n  draft.nome = texto;\n  stage = 'contato';\n  reply = 'Qual telefone ou e-mail você quer colocar no currículo?';\n} else if (etapa === 'contato') {\n  reply = 'Já anotei seu nome. A etapa de contato será implementada a seguir.';\n}\n\nreturn { json: { sender_id: entrada.sender_id, stage, draft,\n  revision: $json.revision, reply } };"
      },
